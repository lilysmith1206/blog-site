@namespace Lylink.Site.Blog.Components.Pages

@page "/{slug:nonfile?}"
@using Lylink.Shared.Api.Client.Base

@inject IBlogApiClient BlogApiClient
@inject IAnalyticsApiClient AnalyticsApiClient
@inject ISessionService SessionService
@inject ILogger<Index> Logger
@inject NavigationManager NavigationManager

@layout MainLayout

<PageTitle>@Page?.Metadata?.Title</PageTitle>

<SectionContent SectionName="HeadContent">
    <meta name="keywords" content="@Page?.Metadata?.Keywords" />
    <meta name="description" content="@Page?.Metadata?.Description" />
</SectionContent>

<SectionContent SectionName="Header">
    <PageHeader PageName="@Page?.Name"
                Parents="@(Page?.Parents ?? [])"
                DateModified="Page?.Metadata?.DateModified"/>
</SectionContent>

<main>
    <LoadingFacade FacadeHeight="60vh"
                   Loading="Loading">
        <RenderedComponentOnLoad>
            @((MarkupString)(Page?.HtmlContent ?? string.Empty))

            @if (Page?.Children?.Any() == true)
            {
                <h3>Sub-categories</h3>
                <ul>
                    @foreach (PageLink postCategory in Page.Children)
                    {
                        <li>
                            <a href="@postCategory.Slug" title="@postCategory.Description">@postCategory.Name</a>
                        </li>
                    }
                </ul>
            }

            @if (Page?.Posts?.Any() == true)
            {
                <h3>Posts</h3>
                <ul>
                    @foreach (var post in Page.Posts)
                    {
                        <li>
                            <a href="@post.Slug" title="@post.Description">@post.Name</a>
                        </li>
                    }
                </ul>
            }
        </RenderedComponentOnLoad>
    </LoadingFacade>
</main>

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private bool Loading = true;
    private Page? Page = null;

    protected override async Task OnParametersSetAsync()
    {
        Loading = true;
        Page = null;

        await InvokeAsync(StateHasChanged);

        var page = await BlogApiClient.GetPageFromSlug(Slug);

        page.Switch(page =>
        {
            Page = page;

            Task.Run(() => AnalyticsApiClient.CreateSuccessVisitAnalytic(new()
            {
                Visited = Slug,
                SessionId = SessionService.SessionId,
                Date = DateTime.UtcNow,
            }));
        }, errors =>
        {
            var error = errors.First();

            Logger.LogError("An error occurred when fetching the page: {error}", error);

            if (error.Type == ErrorType.NotFound)
            {
                Logger.LogInformation("Redirecting to not found page.");

                Task.Run(() => AnalyticsApiClient.CreateFailureVisitAnalytic(new()
                {
                    Attempted = Slug,
                    RedirectedTo = "404",
                    SessionId = SessionService.SessionId,
                    Date = DateTime.UtcNow
                }));

                NavigationManager.NavigateTo("/404");
            }
            else if (errors.First().Type == ErrorType.NotAvailable)
                NavigationManager.NavigateTo("/unavailable");
        });

        Loading = false;

        await InvokeAsync(StateHasChanged);
    }
}