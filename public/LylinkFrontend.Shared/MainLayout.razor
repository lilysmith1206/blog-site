@using LylinkBackend_API_Shared.Models
@using LylinkFrontend.Shared
@using LylinkShared.Models
@using Microsoft.AspNetCore.Components.Sections
@using Microsoft.Extensions.Options
@using Microsoft.JSInterop
@inherits LayoutComponentBase
@inject IOptions<AssetsOriginOptions> AssetsServerOptions

<HeadContent>
    <link rel="icon" type="image/png" href="@($"{AssetsServerOptions.Value.AssetsEndpointHttps}")/css/lylink_icon.ico" />
    <link id="colorStyle" rel="stylesheet" href="@($"{AssetsServerOptions.Value.AssetsEndpointHttps}")/css/color.css" onerror="showAdblockPopup()" asp-append-version="true" />
    <link id="siteStyle" rel="stylesheet" href="@($"{AssetsServerOptions.Value.AssetsEndpointHttps}")/css/site_style.css" onerror="showAdblockPopup()" asp-append-version="true" />
    <link id="inputStyle" rel="stylesheet" href="@($"{AssetsServerOptions.Value.AssetsEndpointHttps}")/css/input_style.css" onerror="showAdblockPopup()" asp-append-version="true" />
    <link id="tabsStyle" rel="stylesheet" href="@($"{AssetsServerOptions.Value.AssetsEndpointHttps}")/css/tabs_style.css" onerror="showAdblockPopup()" asp-append-version="true" />
    <link id="icon" rel="icon" type="image/x-icon" href="@($"{AssetsServerOptions.Value.AssetsEndpointHttps}")/css/lylink_icon.ico" onerror="showAdblockPopup()" asp-append-version="true" />

    <script src="@($"{AssetsServerOptions.Value.AssetsEndpointHttps}")/js/tabs.js" defer></script>

    <SectionOutlet SectionName="HeadContent" />
</HeadContent>

<div id="adblock-background"></div>
<div id="adblock-popup">
    <p>Hey, it looks like a resource failed to load. If you have an ad-blocker, please turn it off.</p>
    <button onclick="closePopup()">Close</button>
</div>
<div id="page-container">
    <div id="color-toggle">
        <ImageToggle SelectedChanged="OnColorToggleSwitched">
            <First>
                <img src="@($"{AssetsServerOptions.Value.AssetsEndpointHttps}")/images/DarkMode.svg"
                     alt="Dark Mode" />
            </First>

            <Second>
                <img src="@($"{AssetsServerOptions.Value.AssetsEndpointHttps}")/images/LightMode.svg"
                     alt="Light Mode" />
            </Second>
        </ImageToggle>
    </div>
    <SectionOutlet SectionName="Header" @rendermode="RenderMode.InteractiveServer" />
    <div id="content-wrap">
        <div class="container">
            @Body
        </div>
    </div>
    <footer>
        <p><a href="/privacy">Privacy Policy</a> - Copyright 2025, All Rights Reserved</p>
    </footer>
</div>

@code {
    [Inject] IJSRuntime JS { get; set; } = default!;

    private async Task OnColorToggleSwitched(ImageToggle.Selection selection)
    {
        var theme = selection == ImageToggle.Selection.First
            ? "dark"
            : "light";

        await JS.InvokeVoidAsync("setTheme", theme);
    }
}