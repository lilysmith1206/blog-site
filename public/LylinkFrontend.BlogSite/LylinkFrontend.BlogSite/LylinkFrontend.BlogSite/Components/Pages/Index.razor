@rendermode InteractiveServer

@page "/"
@using LylinkBackend.BlogShared.Page
@using LylinkBackend.BlogApiClient
@using LylinkFrontend.BlogSite.Components.Layout
@using LylinkFrontend.Shared
@using LylinkShared.Models
@using Microsoft.AspNetCore.Components.Sections

@inject IBlogApiClient BlogApiClient
@inject ILogger<Index> Logger
@inject NavigationManager Navigation

@layout MainLayout

<PageTitle>@Page?.Metadata?.Title</PageTitle>

<SectionContent SectionName="HeadContent">
    <meta name="keywords" content="@Page?.Metadata?.Keywords" />
    <meta name="description" content="@Page?.Metadata?.Description" />
</SectionContent>

<PageHeader PageName="@Page?.Name"
            Parents="@(Page?.Parents ?? [])" />

<div id="content-wrap">
    <div class="container">
        <main>
            <LoadingFacade FacadeHeight="70vh"
                           Loading="Loading">
                <RenderedComponentOnLoad>
                    @((MarkupString?)(Page?.HtmlContent ?? string.Empty))

                    @if (Page?.Children?.Any() == true)
                    {
                        <h3>Sub-categories</h3>
                        <PageLinkList PageLinks="Page.Children" />
                    }

                    @if (Page?.Posts?.Any() == true)
                    {
                        <h3>Posts</h3>
                        <PageLinkList PageLinks="Page.Posts" />
                    }

                    @if (MostRecentPosts.Any())
                    {
                        <h3>Most recently updated posts</h3>
                        <PageLinkList PageLinks="MostRecentPosts" />
                    }
                </RenderedComponentOnLoad>
            </LoadingFacade>
        </main>
    </div>
</div>

@code {
    private bool Loading = true;

    private Page? Page = null;
    private List<PageLink> MostRecentPosts = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var page = await BlogApiClient.GetIndexPage();

        page.Switch(page => Page = page, error =>
        {
            Logger.LogError("An error occurred when fetching the index page: {error}", error);
        });

        var mostRecentPages = await BlogApiClient.GetMostRecentPosts(10);

        mostRecentPages.Switch(mostRecentPages => MostRecentPosts = mostRecentPages, error =>
        {
            Logger.LogError("An error occurred when fetching the most recent pages: {error}", error);
        });

        Loading = false;

        await InvokeAsync(StateHasChanged);
    }
}